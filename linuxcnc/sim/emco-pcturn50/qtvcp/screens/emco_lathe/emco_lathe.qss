/* emco_lathe — large, legible controls for a shop-floor screen. */

QWidget {
    font-size: 11pt;
}

QPushButton {
    min-height: 34px;
    padding: 2px 10px;
}

/* The reference banner: red until the gate is satisfied (doc 40 §5). */
QLabel#reference_banner {
    font-size: 13pt;
    font-weight: bold;
    padding: 8px;
    color: white;
    background: #c62828;
    border-radius: 4px;
}
QLabel#reference_banner[ok="true"] {
    background: #2e7d32;
}

QPushButton#estop_button {
    font-weight: bold;
    color: white;
    background: #b71c1c;
}

QPushButton#cycle_start {
    font-weight: bold;
    background: #2e7d32;
    color: white;
}
QPushButton#cycle_start:disabled {
    background: #9e9e9e;
}
QPushButton#cycle_stop {
    font-weight: bold;
    background: #ef6c00;
    color: white;
}

/* DRO: work position big, machine position beside it, radius small. */
DROLabel {
    font-family: "DejaVu Sans Mono";
    font-size: 16pt;
    background: black;
    color: #ffeb3b;
    padding: 2px 6px;
}
DROLabel[isHomed="false"] {
    color: #ef5350;
}
DROLabel[small="true"] {
    font-size: 11pt;
    color: #bdbdbd;
}
QLabel#dro_axis {
    font-size: 18pt;
    font-weight: bold;
}

QLabel#proven_label, QLabel#wizard_title {
    font-weight: bold;
}

QPlainTextEdit#messages {
    font-family: "DejaVu Sans Mono";
    font-size: 9pt;
}
